# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Experiment run outputs — results/<run-id>/ is generated by
# scripts/run_experiment.py. Keep the directory itself (see .gitkeep) so a
# fresh clone has somewhere to write to, but never commit actual run data:
# aggregate metrics from a real run may still be sensitive pending review,
# and re-running is how results get regenerated anyway.
results/*
!results/.gitkeep

# Observation cache (execution/cache.py) — populated locally when
# --cache-mode is anything other than LIVE_ONLY. Never commit cached
# provider responses.
.cache/
cache/

# Never commit: the live corpus's real E.164 numbers. Only
# src/reputation_experiment/corpus/public_synthetic_cases.jsonl (opaque
# tokens only) belongs in this repository — see the source document's
# 'Architectural guardrail' section and execution/runner.py's docstrings.
phone_lookup*.json
*.live-corpus.jsonl

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
